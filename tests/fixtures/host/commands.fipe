# The conformance host's command namespace: its bare commands, bindings
# and the types they share. Every name is implemented by the host.
use fs

pub type Rd<Api>
pub Rd: U64 -> Rd<api>
pub type Src
impl Src { read: String -> Result<Self, ParseError> }
pub type Sink
impl Sink { read: String -> Result<Self, ParseError> }
pub type Entry { pub name: String, pub path: String, pub size: U64, pub age: U64 }
impl Entry { read: String -> Result<Self, ParseError> }

pub root: Rd<sys>
pub out: Sink

pub ls: (path: Src = ".") -> (long: Bool = False) -> (recursive: Bool = False) ->
    (depth: U64 = 1) -> (name: String = "*") -> Vec<Entry>
pub cat: Entry -> String
pub find: Src -> Maybe<Entry>
pub grep: (pattern: String) -> String -> String
pub rm: Src -> Result<(), fs.Error>
pub put: (to: Sink) -> Vec<U8> -> ()
pub append: (to: Sink) -> Vec<U8> -> ()
