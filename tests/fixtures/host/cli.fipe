# The conformance host's `cli` module, API version 2.
## A host operation error.
pub type Error: Show {
    ## The error message.
    pub message: String,
}
impl Error: Show { show = self => self.message }

## The requested port.
pub port: Integer
## The requested seed.
pub seed: Integer
## Candidate prime numbers.
pub primes: Vec<Integer>

## A packed RGB sample.
pub rgb: [U8; 3]
