# Lexical and syntax corpus, not a runnable program for Fipe 0.1.0.
# The opening example lives in tests/fixtures/opening.fipe; this file
# covers the remaining surface forms.
use fs
use text 2
use fs.list fs.Entry

dir = sys.lookup root /module/fs/root | Rd<fs>
ls -l dir | filter (e => e.size > 4096) | map .name

add = a b => a + b
add2 = add 2
add2 4
inc: I64 -> I64 = n => n + 1
pub inc2 = n
    => n + 2
max = a b if a > b => a, _ b => b
compose: (I64 -> I64) -> (I64 -> I64) -> I64 -> I64 = f g x => f (g x)
thunk: () -> I64 = () => 1
ls: Rd -> Bool -> Vec<Entry> = dir (long = False) => fs.list dir -l=long

big: Rd<fs> -> U64 -> Result<Vec<String>, fs.Error> = dir min => {
    Ok _ = fs.remove dir /tmp/x
    fs.list dir /etc |: filter (e => e.size > min) |: map .name
}

find x |: cat |! log "gone" || root
find x | {
    Just Entry { name, .. } if name != "" => name,
    [:e] => e.name,
    _ => "-",
}
find x | ([:e] => e.name, [!] => "-")
m: Maybe<I64> = [:1]
pairs | { Just e rest => e, Just Just e => e, _ _ => 0 }

pub type Point { pub x: I64, pub y: I64 = 0, len: U64 }
type Width { w: U64 = 80 }
type Shape { Circle(r: F64), Square(side: F64), Dot }
type Marker {}
type Rd<Api>
impl Point {
    x (y = 0) => Self { x, y, len: hypot x y },
    pub line: I64 -> Self = p => Self p p,
    dist = self q => hypot (self.x - q.x) (self.y - q.y),
}
impl Poly {
    [] => fault "empty",
    ps => Self { pts: ps },
}

type Natural: Integer where 0 <= self
type U8: Natural & Bits<8> where self <= 255
type I8: Integer & Bits<8>
where -128 <= self, self <= 127
type Mode: Size<1> { read: Flag, write: Flag, exec: Flag }
type Range { lo: Integer, hi: Integer } where self.lo <= self.hi
type Shaped where self.area: F64
type Key: Eq & Show
type NonPrime: Integer & !Prime
type Handy: U8 | Prime
type Sorted<T: Ord>: Vec<T> where is_sorted self
type Ring<T, n>: Sequence<T> { slots: [T; n], at: Natural }
impl Integer { add: Self -> (self: Self) -> Self }
impl Ring<T, n>: Sequence<T> { sequence = slots => Self slots 0 }
id: Integer | String = 3
id | { Integer n => n.show, String s => s }
older: b.age: a, Ord a => a -> b -> Bool = d e => e.age > d
flags: [!U8; 3] = [300, 400, 500]

pair: Integer * String = (1, "one")
(n, name) = pair
swap = (a, b) => (b, a)
f(a, b)
f (a, b)
f ((a, b))
zs = xs ++ [4, 5]
grep where

Point 3 4
Point -y 4 -x 3
Point(3, 4)
Width
Circle 1.5
Point.line 2
p.dist q
pl | Point.from
"3,4" | try<Point>
pl | to<Point>
"42" | read<I64> |: add 1 || 0
Point 3 4 | show

values = [199, -5, 0x199, 0o17, 0b1010, 1_000, 18446744073709551616]
floats = [1.5, 1e3, -1.2e-3]
written = [10ms, 2i, 0r7Z, re"a+b"i, b"\x00\xFF"]
text = "a b\n\xC3\xA9"
raw = 'no\nescapes # here'
resource = Rd 4
buffer: [U8; 4] = [0x41, 0x42, 0, 0]
t: Vec<
  U8
> = []
total = price
    * count
    + shipping
wrapped = f(x,
    y)
grouped = (x = 1
    x + 1)
[x, [y], 0] = values
Point { x, .. } = p
n: I64 = round 1.5

ls -c=80 -l=False --width 80 -n=-5 --la -t [a, b]
cat ./x ../x /module/fs/root "-x" --
cat héllo "한글"
cat "#x" # comment ends here
cat x \
    y

cat x | # continuation
    grep foo | put ./output

with cwd /tmp {
    ls
}

if ready { True } else { False }
compare = x y => x <= y
find x || fault "no x"
