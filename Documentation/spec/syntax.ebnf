(* Token grammar; continuation, adjacency, the binding rule, the case rule
   and the list newline rule are in syntax.md. `newlines` marks where a
   list admits line breaks. *)
file = newlines, { entry, NEWLINE, newlines }, [ entry ], EOF ;
entry = [ "pub" ], ( item | declaration | line ) ;
newlines = { NEWLINE } ;

item = import | type_item | trait_item | impl_item ;
declaration = NAME, ":", annotation ;
import = "use", NAME, { NAME }, [ INTEGER ] ;
type_item = "type", NAME, [ type_parameters ], "{", newlines,
            [ members ], newlines, "}" ;
type_parameters = "<", newlines, type_parameter,
                  { ",", newlines, type_parameter }, newlines, ">" ;
type_parameter = NAME, [ ":", NAME ] ;
members = member, { ",", newlines, member }, [ "," ] ;
member = field | NAME, [ "(", newlines, [ fields ], newlines, ")" ] ;
fields = field, { ",", newlines, field }, [ "," ] ;
field = [ "pub" ], NAME, ":", type, [ "=", operand ] ;
trait_item = "trait", NAME, [ type_parameters ], [ ":", NAME ], "{",
             newlines, [ trait_members ], newlines, "}" ;
trait_members = trait_member, { ",", newlines, trait_member }, [ "," ] ;
trait_member = NAME, ":", annotation, [ "=", member_value ] ;
impl_item = "impl", type, [ ":", type ], "{", newlines,
            [ impl_members ], newlines, "}" ;
impl_members = impl_member, { ",", newlines, impl_member }, [ "," ] ;
impl_member = [ "pub" ], NAME, [ ":", annotation ], "=", member_value
            | NAME, "=", type | arm ;
member_value = arm | line ;

annotation = [ constraints, "=>", newlines ], type ;
constraints = constraint, { ",", constraint } ;
constraint = named_type, NAME ;
type = type_atom, [ "->", newlines, type ] ;
type_atom = named_type | unit_type | array_type | "(", type, ")" ;
named_type = NAME, [ type_arguments ] ;
type_arguments = "<", newlines, type, { ",", newlines, type }, newlines, ">" ;
unit_type = "(", ")" ;
array_type = "[", type, ";", INTEGER, "]" ;

line = binding | scoped | pipeline ;
binding = pattern, [ ":", annotation ], "=", line ;
scoped = "with", NAME, operand, block ;
pipeline = stage, { pipe, stage } ;
pipe = "|" | "|:" | "|!" | "||" | "&&" ;
stage = arms | conditional | application | value ;
application = operand, argument, { argument } ;
argument = operand | FLAG, [ "=", operand ] ;
operand = primary, { call | field_access } ;
call = "(", newlines, [ call_arguments ], newlines, ")" ;
call_arguments = call_argument, { ",", newlines, call_argument }, [ "," ] ;
call_argument = line | FLAG, [ "=", operand ] ;
field_access = SELECTOR ;

value = equality ;
equality = comparison, [ ( "==" | "!=" ), comparison ] ;
comparison = sum, [ ( "<" | "<=" | ">" | ">=" ), sum ] ;
sum = product, { ( "+" | "-" ), product } ;
product = unary, { ( "*" | "/" | "%" ), unary } ;
unary = { "!" }, operand ;
primary = literal | NAME | instance | WORD | PATH | SELECTOR | "/"
        | group | list | outcome | record | block ;
literal = INTEGER | FLOAT | STRING | BYTES | unit ;
unit = "(", newlines, ")" ;
instance = NAME, type_arguments ;
group = "(", newlines, body, newlines, ")" ;
block = "{", newlines, [ body ], newlines, "}" ;
body = arms | line, { NEWLINE, newlines, line } ;
list = "[", newlines, [ elements ], newlines, "]" ;
elements = line, { ",", newlines, line }, [ "," ] ;
outcome = "[", ( ":" | "!" ), [ line ], "]" ;
record = NAME, "{", newlines, [ field_values ], newlines, "}" ;
field_values = field_value, { ",", newlines, field_value }, [ "," ] ;
field_value = NAME, [ ":", line ] ;
conditional = "if", stage, block, [ "else", ( conditional | block ) ] ;

arms = arm, { ",", newlines, arm }, [ "," ] ;
arm = head, [ "if", stage ], "=>", newlines, line ;
head = head_pattern, { head_pattern } ;
head_pattern = pattern | "(", NAME, "=", operand, ")" ;
pattern = pattern_atom | NAME, pattern ;
pattern_atom = literal | NAME | list_pattern | outcome_pattern
             | record_pattern | "(", pattern, ")" ;
list_pattern = "[", newlines, [ pattern, { ",", newlines, pattern }, [ "," ] ],
               newlines, "]" ;
outcome_pattern = "[", ( ":" | "!" ), [ pattern ], "]" ;
record_pattern = NAME, "{", newlines, [ pattern_fields ], newlines, "}" ;
pattern_fields = pattern_field, { ",", newlines, pattern_field }, [ "," ] ;
pattern_field = NAME, [ ":", pattern ] | WORD ;
