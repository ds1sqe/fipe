(* Character-level forms. lexical.md defines maximal word boundaries,
   ordered classification, the order that reads a number's prefix and
   suffix, initial BOM skipping, symbol matching, newline suppression
   and errors. A keyword is not a quote's prefix or suffix.
   A ? ... ? sequence denotes the exact character set described within it. *)
token = keyword | symbol | name | selector | word | flag | path
      | number | text | doc | inner_doc | newline ;
doc = "##", doc_text ;
inner_doc = "##!", doc_text ;
doc_text = ? scalars through but excluding LF and a CR right before it,
             the first not "#"; one leading space stripped ? ;
(* A line join, backslash then spacing then LF or EOF outside quotes and
   comments, is discarded before tokenization and yields no token. *)

name = identifier, { ".", identifier } ;
identifier = name_start, { name_continue } ;
name_start = letter | "_" ;
name_continue = name_start | digit ;
letter = ? ASCII A-Z or a-z ? ;
digit = ? ASCII 0-9 ? ;
hex_digit = digit | ? ASCII A-F or a-f ? ;
oct_digit = ? ASCII 0-7 ? ;
bin_digit = "0" | "1" ;

word = word_scalar, { word_scalar } ;
word_scalar = ? Unicode scalar except spacing, LF, C0/C1 controls,
                U+FEFF, U+200B and
                ( ) { } [ ] , ; : = < > ! | & double-quote single-quote # ? ;
flag = ( "-" | "--" ), letter, { word_scalar } ;
selector = ".", name ;
path = ( "/" | "./" | "../" ), { word_scalar } ;

decimal = digit, { [ "_" ], digit } ;
hex = hex_digit, { [ "_" ], hex_digit } ;
oct = oct_digit, { [ "_" ], oct_digit } ;
bin = bin_digit, { [ "_" ], bin_digit } ;
sign = [ "-" ] ;
integer = sign, ( decimal | "0x", hex | "0o", oct | "0b", bin ) ;
exponent = ( "e" | "E" ), [ "+" | "-" ], decimal ;
float = sign, ( decimal, ".", decimal, [ exponent ] | decimal, exponent ) ;
number = ( integer | float ), [ suffix ]
       | sign, "0", prefix_letter, alnum, { alnum } ;
suffix = letter, { name_continue } ;
prefix_letter = ? ASCII a-z except x, o and b ? ;
alnum = letter | digit ;

double_quote = ? U+0022 ? ;
single_quote = ? U+0027 ? ;
backslash = ? U+005C ? ;
text = [ prefix ], ( string | raw_string ), [ identifier ] ;
prefix = ( lower | "_" ), { lower | digit | "_" } ;
lower = ? ASCII a-z ? ;
string = double_quote, { text_scalar | escape | quote_join }, double_quote ;
quote_join = backslash, [ cr ], newline, { spacing } ;
cr = ? U+000D ? ;
spacing = ? spacing scalars listed in lexical.md, excluding LF ? ;
raw_string = single_quote, { raw_scalar }, single_quote ;
text_scalar = ? Unicode scalar except double-quote, backslash and
                U+FEFF, U+200B, C0/C1 controls other than TAB ? ;
raw_scalar = ? Unicode scalar except single-quote and
               U+FEFF, U+200B, C0/C1 controls other than TAB, LF
               and a CR right before an LF ? ;
escape = backslash, ( "n" | "t" | "r" | backslash | double_quote
                   | single_quote | "0" | "x", hex_digit, hex_digit ) ;

keyword = "if" | "else" | "with" | "type" | "impl" | "use" | "pub" ;
symbol = "+" | "-" | "*" | "/" | "%" | "++" | "(" | ")" | "{" | "}" | "[" | "]"
       | "," | ";" | ":" | "=" | "==" | "!" | "!=" | "<" | "<="
       | ">" | ">=" | "->" | "=>" | "|" | "|:" | "|!" | "||" | "&" | "&&" ;
newline = ? U+000A LF ? ;
