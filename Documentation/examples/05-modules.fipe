# Modules and the host: a file is a module named by its stem, `use` brings
# a module or its names in, `pub` exports, and `with` scopes the host's
# environment for one block.
use fs
use geometry.Point geometry.Polar
use cli 2

# A `pub` binding may be polymorphic; a host-callable one is written out.
## Compute a rectangular area.
pub area: F64 -> F64 -> F64 = w h => w * h
## Run the module example.
pub main: Vec<String> -> Result<(), cli.Error> = args => {
    name = first args || "0,0"
    p: Point = read name || Point 0 0
    p | Polar.from | show | put out
    Ok ()
}

# A handle is a host type made by a host function.
dir = sys.lookup root /module/fs/root | Rd<fs>

# A module member and a field use the same dot; the checker tells them
# apart by what `fs` and `e` are.
[:e] = fs.list dir /etc | first
e.name
fs.size e

# `with` evaluates its block under a child environment.
with cwd /tmp {
    ls | map .name | put ./listing
}
with lang "C" { cat ./names | lines | sort }

# Faults end the run; `Err` values do not.
# check: Ord a, Literal a => a -> Result<a, b>
check = n => if n < 0 { fault "negative" } else { Ok n }
