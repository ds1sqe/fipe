# A library module: `05-modules.fipe` imports `Point` and `Polar` from it.
pub type Point { pub x: I64, pub y: I64 = 0 }
impl Point { pub show: Self -> String = self => join "," [show self.x, show self.y] }
impl Point {
    pub read: String -> Result<Self, ParseError> = s => s | split "," | map read<I64> | collect |: {
        [x, y] => Ok (Self x y),
        _ => Err (ParseError "two numbers"),
    },
}

pub type Polar { pub r: F64, pub t: F64 }
impl Polar { pub from: Point -> Self = p => Self { r: hypot p.x p.y, t: atan2 p.y p.x } }
impl Polar { pub show: Self -> String = self => join "@" [show self.r, show self.t] }
