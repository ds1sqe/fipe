# Types: a `type` is its shape, an `impl` is its code, and the type name is
# its constructor. Conversion is a written word, never a spot's guess.

# A record. Lowercase members are fields; `len` is private and computed
# from the fields before it. A default is an operand, so a call is grouped.
## A point with integer coordinates.
pub type Point: Eq & Ord & Show & Read & TryFrom<Polar, RangeError> {
    ## The horizontal coordinate.
    pub x: I64,
    ## The vertical coordinate.
    pub y: I64 = 0,
    len: U64 = (hypot x y),
}

# A sum. Uppercase members are constructors, each with named fields.
## A circle, rectangle or dot.
pub type Shape { Circle(r: F64), Rect(w: F64, h: F64), Dot }

# A newtype is a record with one field.
type Width { w: U64 = 80 }

# Code lives in the impl. Bare arms are the written constructor; `Self { }`
# is the raw construction, legal here because the fields are visible.
impl Point {
    x (y = 0) => Self { x, y, len: hypot x y },
    ## The point at the origin.
    pub origin = Self 0 0,
    ## A point with equal coordinates.
    pub line: I64 -> Self = p => Self p p,
    # dist: Point -> Point -> F64
    dist = self q => hypot (self.x - q.x) (self.y - q.y),
    # scale: Point -> Integer -> Point
    scale = self k => Self (self.x * k) (self.y * k),
}

impl Shape {
    area = self => self | {
        Circle r => 3.14159 * r * r,
        Rect { w, h } => w * h,
        Dot => 0.0,
    },
}

# Members: `show` prints, `Read` parses, and each is on the type it reads.
impl Point: Show { show = self => join "," [show self.x, show self.y] }
impl Point: Read {
    read = s => s | split "," | map read<I64> | collect |: {
        [x, y] => Ok (Self x y),
        _ => Err (ParseError "two numbers"),
    },
}

# Conversion: the target owns its from and try_from members.
## A point in polar coordinates.
pub type Polar: Eq & Ord & Show & From<Point> {
    ## The radius.
    pub r: F64,
    ## The angle.
    pub t: F64,
}
## A radius outside the admitted range.
pub type RangeError: Show {
    ## The radius.
    pub r: F64,
}
impl RangeError: Show { show = self => join " " ["out of range:", show self.r] }
impl Polar: From<Point> { from: Point -> Self = p => Self { r: hypot p.x p.y, t: atan2 p.y p.x } }
impl Point: TryFrom<Polar, RangeError> {
    try_from: Polar -> Result<Self, RangeError> = p => if p.r < 1e9 {
        Ok (Point (round (p.r * (cos p.t))) (round (p.r * (sin p.t))))
    } else {
        Err (RangeError p.r)
    },
}

# Use.
p = Point 3 4                     # the constructor
q = Point -y 1 -x 2               # named spots
o = Point.origin
d = p.dist q                      # the dot fills `self`
p.scale 2 | show                  # "6,8"
Circle 1.5 | .area
[Circle 1.0, Rect 2.0 3.0, Dot] | map .area | sum

pl = p | Polar.from               # Polar's From<Point>
p | to<Polar>                     # the neutral word, same impl
back = pl | try<Point>            # Result<Point, RangeError>
back |: show || "out of range"
"3,4" | read<Point>               # Result<Point, ParseError>
Width                             # the default, 80
