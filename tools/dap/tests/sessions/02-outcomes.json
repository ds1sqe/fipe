      }
    },
    {
      "seq": 3,
      "type": "request",
      "command": "configurationDone"
    },
    {
      "seq": 4,
      "type": "request",
      "command": "threads"
    },
    {
      "seq": 5,
      "type": "request",
      "command": "disconnect"
    }
  ],
  "events": [
    "initialized",
    "output...",
    "exited",
    "terminated"
