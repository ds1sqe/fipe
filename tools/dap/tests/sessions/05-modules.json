{
  "about": "Launch 05-modules.fipe under the replay host over its trace fixture and run it to its end.",
  "example": "05-modules",
  "requests": [
    {
      "seq": 1,
      "type": "request",
      "command": "initialize",
      "arguments": {
        "adapterID": "fipe"
      }
    },
    {
      "seq": 2,
      "type": "request",
      "command": "launch",
      "arguments": {
        "program": "${ROOT}/Documentation/examples/05-modules.fipe",
        "host": "${ROOT}/tests/fixtures/host",
        "trace": "${ROOT}/tests/fixtures/traces/05-modules.txt"
      }
    },
    {
      "seq": 3,
      "type": "request",
      "command": "configurationDone"
    },
    {
      "seq": 4,
      "type": "request",
      "command": "threads"
    },
    {
      "seq": 5,
      "type": "request",
      "command": "disconnect"
    }
  ],
  "ends": "terminated",
  "outputs": "the call lines of the example's trace fixture; its first line as the value, or as the Fault's description"
}
