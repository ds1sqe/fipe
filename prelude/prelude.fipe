# The Fipe prelude, parsed by the crate's own parser at start. It is
# written with the declaration forms: a name or impl member with no
# value is implemented by the crate.

# Primitive types, opaque: their values come from literals and words.
pub type i8
pub type i16
pub type i32
pub type i64
pub type u8
pub type u16
pub type u32
pub type u64
pub type f32
pub type f64
pub type Vec<T>
pub type Deque<T>

# Prelude types.
pub type Bool { True, False }
pub type String { bytes: Vec<u8> }
pub type Ordering { Less, Equal, Greater }
pub type Maybe<T> { Just(v: T), Nothing }
pub type Result<T, E: Err> { Ok(v: T), Err(e: E) }
pub type Either<L, R> { Left(l: L), Right(r: R) }
pub type ParseError { pub message: String }
pub type Utf8Error { pub at: u64 }
pub type Count<T> { pub item: T, pub n: u64 }

# Derived classes: the checker supplies every instance; no user impl.
pub trait Eq { eq: Self -> Self -> Bool }
pub trait Ord: Eq { cmp: Self -> Self -> Ordering }
pub trait Show { repr: Self -> String }
pub trait Num {
    add: Self -> Self -> Self,
    sub: Self -> Self -> Self,
    mul: Self -> Self -> Self,
    div: Self -> Self -> Self,
    rem: Self -> Self -> Self,
}
pub trait Float: Num {}

# Declared classes.
pub trait Display { display: Self -> String }
pub trait Err: Display {}
pub trait Read { read: String -> Result<Self, ParseError> }
pub trait Len { len: Self -> u64 }
pub trait From<A> { from: A -> Self }
pub trait Into<B> { into: Self -> B }
pub trait TryFrom<A> { Error: Err, try_from: A -> Result<Self, Self.Error> }
pub trait TryInto<B> { Error: Err, try_into: Self -> Result<B, Self.Error> }
pub trait Functor { map: (a -> b) -> Self<a> -> Self<b> }
pub trait Monad: Functor {
    pure: a -> Self<a>,
    then: (a -> Self<b>) -> Self<a> -> Self<b>,
}
pub trait Alternative {
    empty: Self<a>,
    or: Self<a> -> Self<a> -> Self<a>,
}

# Instances: written here, or supplied by the crate when the body is empty.
impl ParseError: Display { display = self => self.message }
impl ParseError: Err {}
impl Utf8Error: Display {
    display = self => join "" ["invalid UTF-8 at ", show self.at],
}
impl Utf8Error: Err {}
impl String: Display { display = self => self }
impl String: Len {}
impl Vec: Len {}
impl Vec: Functor {}
impl Maybe: Functor {
    map = f m => m | { Just v => Just (f v), Nothing => Nothing },
}
impl Maybe: Monad {
    pure = v => Just v,
    then = f m => m | { Just v => f v, Nothing => Nothing },
}
impl Maybe: Alternative {
    empty = Nothing,
    or = a b => a | { Just _ => a, Nothing => b },
}
impl Result: Functor {
    map = f r => r | { Ok v => Ok (f v), Err e => Err e },
}
impl Result: Monad {
    pure = v => Ok v,
    then = f r => r | { Ok v => f v, Err e => Err e },
}

# Conversion words. `to` and `try` resolve either side of a direction;
# their obligation is the checker's, so they carry no constraint here.
pub show: Show a => a -> String
pub to: a -> b
pub try: a -> Result<b, e>

# Text and bytes; the value comes last, so the pipe fills it.
pub bytes: String -> Vec<u8>
pub utf8: Vec<u8> -> Result<String, Utf8Error>
pub lines: String -> Vec<String>
pub words: String -> Vec<String>
pub split: (at: String) -> String -> Vec<String>
pub join: (sep: String) -> Vec<String> -> String
pub lower: String -> String
pub upper: String -> String

# Numbers.
pub round: Float a => a -> a
pub trunc: Float a => a -> a
pub floor: Float a => a -> a
pub ceil: Float a => a -> a
pub sqrt: f64 -> f64
pub sin: f64 -> f64
pub cos: f64 -> f64
pub atan2: (y: f64) -> (x: f64) -> f64
pub hypot: (x: f64) -> (y: f64) -> f64

# Collections.
pub filter: (a -> Bool) -> Vec<a> -> Vec<a>
pub fold: b -> (b -> a -> b) -> Vec<a> -> b
pub first: Vec<a> -> Maybe<a>
pub head: Vec<a> -> a
pub take: (n: u64) -> Vec<a> -> Vec<a>
pub flatten: Vec<Vec<a>> -> Vec<a>
pub collect: Vec<Result<a, e>> -> Result<Vec<a>, e>
pub sum: Num a => Vec<a> -> a
pub count: Eq a => Vec<a> -> Vec<Count<a>>
pub sort: Ord k => (by: a -> k = (x => x)) -> (desc: Bool = False) ->
    Vec<a> -> Vec<a>

# Effects the language owns.
pub fault: String -> a
pub log: a -> a
