# Parsed by the crate; signature-only members are supplied by it.
## An integer with no fixed width.
pub type Integer
## A nonnegative integer.
pub type Natural: Integer where 0 <= self
## An integer in the signed 8-bit range.
pub type I8: Integer & Bits<8> where -128 <= self, self <= 127
## An integer in the signed 16-bit range.
pub type I16: Integer & Bits<16> where -32768 <= self, self <= 32767
## An integer in the signed 32-bit range.
pub type I32: Integer & Bits<32> where -2147483648 <= self, self <= 2147483647
## An integer in the signed 64-bit range.
pub type I64: Integer & Bits<64> where -9223372036854775808 <= self, self <= 9223372036854775807
## A natural in the unsigned 8-bit range.
pub type U8: Natural & Bits<8> where self <= 255
## A natural in the unsigned 16-bit range.
pub type U16: Natural & Bits<16> where self <= 65535
## A natural in the unsigned 32-bit range.
pub type U32: Natural & Bits<32> where self <= 4294967295
## A natural in the unsigned 64-bit range.
pub type U64: Natural & Bits<64> where self <= 18446744073709551615
## A binary32 floating-point value.
pub type F32
## A binary64 floating-point value.
pub type F64
## A bit-width holding.
pub type Bits<n>
## A value known at compile time.
pub type Compile
## A value known once its module has run.
pub type Init
## A fixed-size holding.
pub type Size<n>
## A sequence of elements.
pub type Vec<T>
## A double-ended sequence of elements.
pub type Deque<T>
## A failed limit check.
pub type LimitError
## A truth value.
pub type Bool: Eq & Ord & Show & Not & Default { True, False }
## UTF-8 text.
pub type String: Eq & Ord & Concat & Show & Len & Literal { bytes: Vec<U8> }
## The result of comparing two values.
pub type Ordering: Eq & Ord & Show { Less, Equal, Greater }
## A value or its absence.
pub type Maybe<T>: Eq & Ord & Show & Default { Just(v: T), Nothing }
## A success value or an error.
pub type Result<T, E>: Eq & Ord & Show { Ok(v: T), Err(e: E) }
## One of two alternatives.
pub type Either<L, R>: Eq & Ord & Show { Left(l: L), Right(r: R) }
## An error reading text as a value.
pub type ParseError: Eq & Ord & Show {
    ## The error message.
    pub message: String,
}
## An invalid UTF-8 byte sequence.
pub type Utf8Error: Eq & Ord & Show {
    ## The failing byte position.
    pub at: Natural,
}
## An item and its occurrence count.
pub type Count<T>: Eq & Ord & Show {
    ## The counted item.
    pub item: T,
    ## The occurrence count.
    pub n: Natural,
}
## The exact written form of a literal.
pub type Form: Eq & Ord & Show {
    Whole(value: Integer, radix: U8, digits: Natural, prefix: String, suffix: String),
    Fraction(digits: Integer, exponent: Integer, prefix: String, suffix: String),
    Text(value: String, prefix: String, suffix: String),
    Bytes(value: Vec<U8>, prefix: String, suffix: String),
}
## An addition member with a right operand and result.
pub type Add<R = Self, O = Self> where self.add: R -> O
## A subtraction member with a right operand and result.
pub type Sub<R = Self, O = Self> where self.sub: R -> O
## A multiplication member with a right operand and result.
pub type Mul<R = Self, O = Self> where self.mul: R -> O
## A division member with a right operand and result.
pub type Div<R = Self, O = Self> where self.div: R -> O
## A remainder member with a right operand and result.
pub type Rem<R = Self, O = Self> where self.rem: R -> O
## A concatenation member.
pub type Concat where self.concat: Self -> Self
## An equality member.
pub type Eq where self.eq: Self -> Bool
## Equality and ordering members.
pub type Ord: Eq where self.cmp: Self -> Ordering
## A member that renders a value as text.
pub type Show where self.show: String
## A member that reads text into a value.
pub type Read where Self.read: String -> Result<Self, ParseError>
## A length member.
pub type Len where self.len: Natural
## A logical negation member.
pub type Not where self.not: Self
## A member that reads a written literal form.
pub type Literal where Self.literal: Form -> Self
## A conversion from another meaning.
pub type From<A> where Self.from: A -> Self
## A fallible conversion from another meaning.
pub type TryFrom<A, E> where Self.try_from: A -> Result<Self, E>
## The additive identity.
pub type Zero where Self.zero: Self
## The value of an empty place.
pub type Default where Self.default: Self
## Arithmetic, ordering and literal members.
pub type Number: Add & Sub & Mul & Div & Rem & Ord & Literal
## Number members and rounding.
pub type Float: Number where self.round: Self
impl Integer: Number {
    add: Self -> (self: Self) -> Self,
    sub: Self -> (self: Self) -> Self,
    mul: Self -> (self: Self) -> Self,
    div: Self -> (self: Self) -> Self,
    rem: Self -> (self: Self) -> Self,
    eq: Self -> (self: Self) -> Bool,
    cmp: Self -> (self: Self) -> Ordering,
    literal: Form -> Self,
}
impl Integer: Show { show: (self: Self) -> String }
impl Integer: Read { read: String -> Result<Self, ParseError> }
impl Integer: Zero { zero: Self }
impl F32: Float {
    add: Self -> (self: Self) -> Self,
    sub: Self -> (self: Self) -> Self,
    mul: Self -> (self: Self) -> Self,
    div: Self -> (self: Self) -> Self,
    rem: Self -> (self: Self) -> Self,
    eq: Self -> (self: Self) -> Bool,
    cmp: Self -> (self: Self) -> Ordering,
    literal: Form -> Self,
    round: (self: Self) -> Self,
}
impl F32: Show { show: (self: Self) -> String }
impl F32: Read { read: String -> Result<Self, ParseError> }
impl F32: Zero { zero: Self }
impl F32 {
    trunc: (self: Self) -> Self,
    floor: (self: Self) -> Self,
    ceil: (self: Self) -> Self,
}
impl F64: Float {
    add: Self -> (self: Self) -> Self,
    sub: Self -> (self: Self) -> Self,
    mul: Self -> (self: Self) -> Self,
    div: Self -> (self: Self) -> Self,
    rem: Self -> (self: Self) -> Self,
    eq: Self -> (self: Self) -> Bool,
    cmp: Self -> (self: Self) -> Ordering,
    literal: Form -> Self,
    round: (self: Self) -> Self,
}
impl F64: Show { show: (self: Self) -> String }
impl F64: Read { read: String -> Result<Self, ParseError> }
impl F64: Zero { zero: Self }
impl F64 {
    trunc: (self: Self) -> Self,
    floor: (self: Self) -> Self,
    ceil: (self: Self) -> Self,
}
impl Bool: Not { not: (self: Self) -> Self }
impl String: Concat { concat: Self -> (self: Self) -> Self }
impl String: Show { show: (self: Self) -> String }
impl String: Len { len: (self: Self) -> Natural }
impl String: Literal { literal: Form -> Self }
impl Vec: Concat { concat: Vec<a> -> (self: Vec<a>) -> Vec<a> }
impl Vec: Len { len: (self: Vec<a>) -> Natural }
impl Vec: Literal { literal: Form -> Vec<U8> }
impl Vec: Eq { eq: Eq a => Vec<a> -> (self: Vec<a>) -> Bool }
impl Vec: Ord {
    cmp: Ord a => Vec<a> -> (self: Vec<a>) -> Ordering,
}
impl Vec: Show { show: Show a => (self: Vec<a>) -> String }
impl Vec: Default { default: Vec<a> }
impl Deque: Eq { eq: Eq a => Deque<a> -> (self: Deque<a>) -> Bool }
impl Deque: Ord {
    cmp: Ord a => Deque<a> -> (self: Deque<a>) -> Ordering,
}
impl Deque: Show { show: Show a => (self: Deque<a>) -> String }
impl Deque: Default { default: Deque<a> }
impl Vec { map: (a -> b) -> (self: Vec<a>) -> Vec<b> }
impl Maybe {
    map: (a -> b) -> (self: Maybe<a>) -> Maybe<b>,
    pure: a -> Maybe<a>,
    then: (a -> Maybe<b>) -> (self: Maybe<a>) -> Maybe<b>,
    empty: Maybe<a>,
    or: Maybe<a> -> (self: Maybe<a>) -> Maybe<a>,
}
impl Result {
    map: (a -> b) -> (self: Result<a, e>) -> Result<b, e>,
    pure: a -> Result<a, e>,
    then: (a -> Result<b, e>) -> (self: Result<a, e>) -> Result<b, e>,
}
## Render a value as text.
pub show: Show a => a -> String
## Return the number of elements.
pub len: Len a => a -> Natural
## Read text as the requested meaning.
pub read: Read a => String -> Result<a, ParseError>
## Enter the requested type.
pub to: a -> b
## Try to enter the requested type.
pub try: a -> Result<b, e>
## Apply a function to each element.
pub map: c.map: (a -> b) -> d => (a -> b) -> c -> d
## Concatenate two values.
pub concat: a.concat: b -> c => b -> a -> c

# Text and bytes; the value comes last, so the pipe fills it.
## Return the UTF-8 bytes of text.
pub bytes: String -> Vec<U8>
## Decode UTF-8 bytes, reporting invalid input.
pub utf8: Vec<U8> -> Result<String, Utf8Error>
## Split text into lines.
pub lines: String -> Vec<String>
## Split text into words.
pub words: String -> Vec<String>
## Split text at a separator.
## - at: the separator
pub split: (at: String) -> String -> Vec<String>
## Join text elements with a separator.
## - sep: the separator
pub join: Items<String> c => (sep: String) -> c -> String
## Convert text to lowercase.
pub lower: String -> String
## Convert text to uppercase.
pub upper: String -> String

# Numbers.
## Round to the nearest integer value.
pub round: Float a => a -> a
## Round toward zero.
pub trunc: Float a => a -> a
## Round downward.
pub floor: Float a => a -> a
## Round upward.
pub ceil: Float a => a -> a
## Return the square root.
pub sqrt: F64 -> F64
## Return the sine.
pub sin: F64 -> F64
## Return the cosine.
pub cos: F64 -> F64
## Return the angle of a point.
## - y: the vertical coordinate
## - x: the horizontal coordinate
pub atan2: (y: F64) -> (x: F64) -> F64
## Return the length of a two-dimensional vector.
## - x: the horizontal component
## - y: the vertical component
pub hypot: (x: F64) -> (y: F64) -> F64

# Collections.
## Keep elements satisfying a predicate.
pub filter: Items<a> c => (a -> Bool) -> c -> Vec<a>
## Accumulate elements from an initial value.
pub fold: Items<a> c => b -> (b -> a -> b) -> c -> b
## Return the first element, if present.
pub first: Items<a> c => c -> Maybe<a>
## Return the first element.
pub head: Items<a> c => c -> a
## Keep the first elements.
## - n: the maximum number to keep
pub take: Items<a> c => (n: Natural) -> c -> Vec<a>
## Join nested sequences into one sequence.
pub flatten: Items<Vec<a>> c => c -> Vec<a>
## Collect successes or return an error.
pub collect: Items<Result<a, e>> c => c -> Result<Vec<a>, e>
## Sum the elements.
pub sum: Add a, Zero a, Items<a> c => c -> a
## Count occurrences of each distinct item.
pub count: Eq a, Items<a> c => c -> Vec<Count<a>>
## Order elements by a key.
## - by: the key function
## - desc: whether to reverse the order
pub sort: Ord k, Items<a> c => (by: a -> k = (x => x)) -> (desc: Bool = False) ->
    c -> Vec<a>

# Effects the language owns.
## End execution with a Fault.
pub fault: String -> a
## Log a value and return it.
pub log: a -> a

## A bracket constructor.
pub type Sequence<T> where Self.sequence: [T; n] -> Self
## A front-to-back walk with an accumulator.
pub type Items<T> where self.fold: b -> (b -> T -> b) -> b
impl Vec<T>: Sequence<T> { sequence: [T; n] -> Self }
impl Deque<T>: Sequence<T> { sequence: [T; n] -> Self }
impl Vec<T>: Items<T> { fold: b -> (b -> T -> b) -> (self: Self) -> b }
impl Deque<T>: Items<T> { fold: b -> (b -> T -> b) -> (self: Self) -> b }
impl Vec<T>: From<[T; n]> { from: [T; n] -> Self }
impl [T; n] {
    concat: [T; m] -> (self: Self) -> [T; n + m],
    map: (T -> b) -> (self: Self) -> [b; n],
}
impl [T; n]: Items<T> { fold: b -> (b -> T -> b) -> (self: Self) -> b }
impl [T; n]: Len { len: (self: Self) -> Natural }
